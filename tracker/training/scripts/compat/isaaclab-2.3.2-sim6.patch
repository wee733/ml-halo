+        # the importer relocates its temporary URDF, and fail on missing geometry.
+        asset_dir = os.path.dirname(os.path.abspath(cfg.asset_path))
+        for mesh in tree.getroot().iter("mesh"):
+            filename = mesh.get("filename", "")
+            if filename.startswith("package://"):
+                continue
+            filename = filename.removeprefix("file://")
+            candidates = [os.path.join(asset_dir, filename), os.path.join(os.path.dirname(asset_dir), filename)]
+            resolved = next((candidate for candidate in candidates if os.path.isfile(candidate)), None)
+            if resolved is None:
+                raise FileNotFoundError(f"URDF mesh does not exist: {filename} in {cfg.asset_path}")
+            mesh.set("filename", os.path.abspath(resolved))
+        input_dir = os.path.join(self.usd_dir, "resolved_urdf")
+        os.makedirs(input_dir, exist_ok=True)
+        input_path = os.path.join(input_dir, os.path.basename(cfg.asset_path))
+        tree.write(input_path, encoding="utf-8", xml_declaration=True)
+        import_config = URDFImporterConfig(
+            urdf_path=input_path,
+            usd_path=os.path.normpath(self.usd_dir),
+            merge_fixed_joints=cfg.merge_fixed_joints,
+            collision_from_visuals=cfg.collision_from_visuals,
+            collision_type={
